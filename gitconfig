[init]
	defaultBranch = main

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # Gunakan tombol 'n' dan 'N' untuk lompat antar file diff
    line-numbers = true
    side-by-side = false
    syntax-theme = Catppuccin Mocha

[merge]
    conflictstyle = zdiff3
